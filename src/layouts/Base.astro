---
import '../styles/global.css';
import Landscape from '../components/Landscape.astro';
import { site, links } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}

const { title, description = site.description, home = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name}, ${site.role.toLowerCase()} in ${site.location}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const path = Astro.url.pathname;
const nav = [
  { href: '/about', label: 'About' },
  { href: '/work', label: 'Work' },
  { href: '/pictures', label: 'Pictures' },
];

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: site.role,
  worksFor: { '@type': 'Organization', name: 'E Dijital Bilişim Hizmetleri' },
  homeLocation: { '@type': 'Place', name: 'İstanbul, Türkiye' },
  sameAs: links.filter((l) => l.href.startsWith('https')).map((l) => l.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#fcfcfa" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', site.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Plain-text summary for language models" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..500&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body class:list={{ home }}>
    {
      !home && (
        <header class="top col">
          <a class="name" href="/">{site.name}</a>
          <nav aria-label="Primary">
            {nav.map((n) => (
              <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>
                {n.label}
              </a>
            ))}
          </nav>
        </header>
      )
    }
    <slot />
    {
      !home && (
        <footer class="foot">
          <Landscape variant="band" rider={false} />
        </footer>
      )
    }
  </body>
</html>

<style>
  .top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    padding: 36px 0 0;
    margin-bottom: 72px;
  }

  .name {
    font-size: 18px;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 22px;
    font-size: 16px;
  }

  nav a {
    text-decoration: none;
    color: var(--ink-soft);
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--green);
  }

  body:not(.home) {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }

  .foot {
    margin-top: auto;
    padding-top: 120px;
    -webkit-mask-image: linear-gradient(transparent 120px, #000 170px);
    mask-image: linear-gradient(transparent 120px, #000 170px);
  }

  @media (max-width: 480px) {
    .top {
      flex-direction: column;
      gap: 6px;
      margin-bottom: 48px;
    }
  }
</style>

---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { site, links } from '../data/site';

interface Props {
  title?: string; // shown after the name in the header
  doc?: string; // the browser tab title, when it differs
  description?: string;
}

const { title, doc = title, description = site.description } = Astro.props;
const fullTitle = doc ? `${doc} — ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, site.url).href;
const path = Astro.url.pathname;
const nav = [
  { href: '/pictures', label: 'pictures' },
  { href: '/blog', label: 'blog' },
];
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: site.role,
  worksFor: { '@type': 'Organization', name: 'E Dijital Bilişim Hizmetleri' },
  homeLocation: { '@type': 'Place', name: 'İstanbul, Türkiye' },
  sameAs: links.filter((l) => l.href.startsWith('https')).map((l) => l.href),
};

// The page body slides out and back in; the header stays put.
const fly = {
  forwards: {
    old: { name: 'flyOut', duration: '350ms', easing: 'ease', fillMode: 'forwards' },
    new: { name: 'flyIn', duration: '350ms', easing: 'ease', delay: '350ms', fillMode: 'backwards' },
  },
  backwards: {
    old: { name: 'flyOut', duration: '350ms', easing: 'ease', fillMode: 'forwards' },
    new: { name: 'flyIn', duration: '350ms', easing: 'ease', delay: '350ms', fillMode: 'backwards' },
  },
};
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', site.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Plain-text summary for language models" />
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" title="Blog — Serkan Ağdaş" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <ClientRouter />
  </head>
  <body>
    <header class="layout">
      <h1>
        <a href="/">{site.name}</a>
        {
          title && (
            <span class="page-title">
              <span class="g">—</span> {title}
            </span>
          )
        }
      </h1>
      <nav aria-label="Primary">
        {
          nav.map((n) => (
            <a href={n.href} class:list={{ on: path.startsWith(n.href) }}>
              {n.label}
            </a>
          ))
        }
      </nav>
    </header>

    <div class="layout body" transition:animate={fly}>
      <slot />
      <footer>
        {
          links.map((l) => (
            <div class="row">
              <span>{l.label}</span>
              <hr />
              <a class="link" href={l.href} rel={l.href.startsWith('http') ? 'me' : undefined}>
                {l.href.startsWith('http') ? `@${l.value}` : l.value}
              </a>
            </div>
          ))
        }
      </footer>
    </div>
  </body>
</html>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.75rem;
  }

  h1 {
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 700;
    color: var(--black);
  }

  .page-title {
    font-weight: 300;
  }

  nav {
    display: flex;
    gap: 1.5rem;
    padding: 0.125rem 0;
    font-size: 1.125rem;
    line-height: 1.75rem;
    color: var(--soft);
  }

  nav a {
    transition: color 0.15s;
  }

  nav a:hover,
  nav a.on {
    color: var(--black);
  }

  .body {
    line-height: 1.25;
  }

  footer {
    display: flex;
    flex-direction: column;
    margin-top: 2rem;
    font-size: 1.125rem;
    line-height: 1.75rem;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .row span {
    color: var(--soft);
  }

  .row hr {
    flex: 1;
    margin-top: 0.125rem;
    border-top-style: dotted;
  }

  @media (min-width: 640px) {
    header {
      margin-bottom: 0.25rem;
    }
  }

  @media (max-width: 580px) {
    .page-title {
      display: block;
      font-size: 1.25rem;
      line-height: 1.75rem;
    }
    .page-title .g {
      display: none;
    }
  }

  @media (max-width: 420px) {
    nav {
      flex-direction: column;
      align-items: flex-end;
      gap: 0;
    }
  }

  @keyframes -global-flyIn {
    from {
      transform: translateX(-10px);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }

  @keyframes -global-flyOut {
    from {
      transform: none;
      opacity: 1;
    }
    to {
      transform: translateY(5px);
      opacity: 0;
    }
  }
</style>

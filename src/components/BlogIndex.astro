---
import type { CollectionEntry } from 'astro:content';
import { tags, day } from '../lib/blog';

interface Props {
  posts: CollectionEntry<'blog'>[];
  active?: string;
}

const { posts, active } = Astro.props;
---

<div class="head">
  <p class="kicker">Blog</p>
  <h1 class="display">Notes from the bench, <em>written as they happen.</em></h1>
</div>

<div class="bar">
  <a class="rss" href="/rss.xml">Subscribe via RSS</a>
  <nav class="tags" aria-label="Tags">
    {active && <a href="/blog">all</a>}
    {
      tags.map((t) => (
        <a href={`/blog/tag/${t}`} aria-current={t === active ? 'page' : undefined}>
          <span>#</span> {t}
        </a>
      ))
    }
  </nav>
</div>

<ol class="posts">
  {
    posts.map((p) => (
      <li>
        <a href={`/blog/${p.id}`}>
          <span class="title">
            {p.data.title} <span class="arrow">↗</span>
          </span>
          <span class="meta">
            <time datetime={p.data.date.toISOString().slice(0, 10)}>{day(p.data.date)}</time>
            <span>{p.data.tag}</span>
          </span>
          <span class="desc">{p.data.description}</span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .head {
    padding-top: 80px;
    margin-bottom: 56px;
    max-width: 900px;
  }
  .bar,
  .posts {
    max-width: 760px;
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 12px;
  }
  .rss {
    font-size: 15px;
    text-decoration-color: var(--green);
    text-underline-offset: 3px;
  }
  .tags {
    display: flex;
    gap: 4px;
    font-size: 14px;
    margin-right: -10px;
  }
  @media (max-width: 520px) {
    .tags {
      margin: 0 0 0 -10px;
    }
  }
  .tags a {
    padding: 4px 10px;
    border-radius: 4px;
    text-decoration: none;
    color: var(--ink-soft);
    transition: background-color 0.2s, color 0.2s;
  }
  .tags a span {
    color: var(--ink-faint);
  }
  .tags a:hover {
    background: var(--blue-tint);
    color: var(--ink);
  }
  .tags a[aria-current='page'] {
    background: var(--blue);
    color: #fff;
  }
  .tags a[aria-current='page'] span {
    color: rgba(255, 255, 255, 0.6);
  }
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .posts a {
    display: grid;
    gap: 2px;
    margin: 0 -14px;
    padding: 16px 14px;
    border-radius: 6px;
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .posts a:hover {
    background: var(--blue-tint);
  }
  .title {
    font-size: 21px;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .arrow {
    color: var(--ink-faint);
    font-size: 0.85em;
    transition: color 0.2s, transform 0.2s;
    display: inline-block;
  }
  .posts a:hover .arrow {
    color: var(--blue);
    transform: translate(2px, -2px);
  }
  .meta {
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    color: var(--ink-faint);
  }
  .meta span {
    color: var(--green);
  }
  .desc {
    color: var(--ink-soft);
    line-height: 1.45;
  }
</style>

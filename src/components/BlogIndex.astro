---
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';
import { tags, day } from '../lib/blog';

interface Props {
  posts: CollectionEntry<'blog'>[];
  active?: string;
}

const { posts, active } = Astro.props;
---

<section class="page">
  <div class="top">
    <div class="label">Blog Posts</div>
    <div class="tags">
      {
        tags.map((t) => (
          <a href={t === active ? '/blog' : `/blog/tag/${t}`} class:list={{ on: t === active }}>
            <span class="g">#</span> {t}
          </a>
        ))
      }
    </div>
  </div>
  <p class="sub"><a class="link" href="/rss.xml">Subscribe</a></p>
  <div class="posts">
    {
      posts.map((p) => (
        <a href={`/blog/${p.id}`}>
          <div class="title">
            {p.data.title} <Arrow />
          </div>
          <div class="meta">
            <span>{day(p.data.date)}</span>
            <span>{p.data.tag}</span>
          </div>
          <div class="desc">{p.data.description}</div>
        </a>
      ))
    }
  </div>
</section>

<style>
  .page {
    padding: 3rem 0;
  }
  .top {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }
  .label {
    font-size: 1.125rem;
    line-height: 1.75rem;
  }
  .tags {
    display: flex;
    gap: 0.5rem;
  }
  .tags a {
    padding: 0.25rem 0.5rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    border-radius: 0.125rem;
    transition: background-color 0.15s;
  }
  .tags a:hover,
  .tags a.on {
    background: var(--hover);
  }
  .tags a.on {
    color: var(--black);
  }
  .sub {
    margin-bottom: 0.5rem;
  }
  .posts {
    display: grid;
    row-gap: 0.5rem;
  }
  .posts a {
    display: block;
    margin: 0 -0.75rem;
    padding: 0.75rem;
    transition: background-color 0.15s;
  }
  .posts a:hover {
    background: var(--hover);
  }
  .title {
    font-size: 1.125rem;
    line-height: 1.75rem;
    color: var(--black);
  }
  .meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.875rem;
    line-height: 1.25rem;
  }
  .desc {
    line-height: 1.375;
    color: var(--soft);
  }
  @media (max-width: 520px) {
    .top {
      flex-direction: column;
      gap: 0.5rem;
    }
    .tags {
      margin-left: -0.5rem;
    }
  }
</style>

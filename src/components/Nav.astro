---
interface Props {
  page: 'home' | 'pictures' | 'other';
}
const { page } = Astro.props;
const home = page === 'home' ? '' : '/';
---

<header class="nav-wrap">
  <nav class="nav glass" aria-label="Primary">
    <a class="brand" href="/" aria-label="serkan.works, home">serkan<span>.works</span><i aria-hidden="true"></i></a>
    <div class="links">
      <a href={`${home}#work`}>work</a>
      <a href="/pictures" aria-current={page === 'pictures' ? 'page' : undefined}>pictures</a>
      <a href={`${home}#contact`}>contact</a>
    </div>
  </nav>
</header>

<style>
  .nav-wrap {
    position: sticky;
    top: 14px;
    z-index: 50;
    width: min(var(--col) + 40px, 100% - 2 * var(--gutter) + 8px);
    margin: 14px auto 0;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 48px;
    padding: 0 8px 0 18px;
    border-radius: 999px;
  }

  .brand {
    font: 500 14px/1 var(--mono);
    text-decoration: none;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    letter-spacing: -0.01em;
  }

  .brand span {
    color: var(--blue);
  }

  .brand i {
    display: inline-block;
    width: 7px;
    height: 14px;
    margin-left: 3px;
    background: var(--blue);
    border-radius: 1px;
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .links {
    display: flex;
    gap: 2px;
  }

  .links a {
    position: relative;
    font: 500 13.5px/1 var(--sans);
    color: var(--ink-2);
    text-decoration: none;
    padding: 10px 12px;
    border-radius: 999px;
    transition: color 0.15s, background-color 0.2s;
  }

  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--ink);
    background: var(--blue-wash);
  }

  @media (max-width: 420px) {
    .nav {
      padding-left: 14px;
    }
    .links a {
      padding: 10px 9px;
    }
  }
</style>

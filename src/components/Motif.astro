---
// One small geometric composition per project and per hobby. Circles, bars and arcs only.
interface Props {
  name: string;
  tone?: 'light' | 'deep';
}
const { name, tone = 'light' } = Astro.props;
const B = 'var(--blue)';
const G = 'var(--green)';
const W = tone === 'deep' ? 'rgba(255,255,255,0.92)' : '#ffffff';
const arcs = [60, 110, 160, 210, 260];
const pages = [0, 1, 2, 3, 4];
---

<svg class:list={['motif', tone]} viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  {
    name === 'prospecting' && (
      <g fill="none" stroke-width="16">
        {arcs.map((r, i) => (
          <path d={`M ${70 + r} 300 A ${r} ${r} 0 0 0 70 ${300 - r}`} stroke={i === 2 ? G : B} opacity={1 - i * 0.14} />
        ))}
        <circle cx="300" cy="80" r="22" fill={G} stroke="none" />
      </g>
    )
  }
  {
    name === 'pitchdeck' && (
      <g>
        <rect x="40" y="60" width="320" height="180" fill={G} />
        <line x1="200" y1="60" x2="200" y2="240" stroke={W} stroke-width="6" />
        <circle cx="200" cy="150" r="44" fill="none" stroke={W} stroke-width="6" />
        <circle cx="282" cy="118" r="18" fill={B} />
      </g>
    )
  }
  {
    name === 'eser-tarama' && (
      <g>
        {pages.map((p) => (
          <rect x={110 + p * 22} y={50 + p * 14} width="150" height="190" fill={p === 4 ? G : B} opacity={p === 4 ? 1 : 0.25 + p * 0.17} />
        ))}
      </g>
    )
  }
  {
    name === 'e-door' && (
      <g>
        <path d="M130 270 V140 A70 70 0 0 1 270 140 V270 Z" fill={B} />
        <circle cx="200" cy="175" r="34" fill={G} />
        <rect x="40" y="270" width="320" height="8" fill={B} opacity="0.4" />
      </g>
    )
  }
  {
    name === 'ajana-gonder' && (
      <g>
        <line x1="80" y1="150" x2="320" y2="150" stroke={B} stroke-width="6" opacity="0.4" />
        <circle cx="80" cy="150" r="30" fill={B} opacity="0.45" />
        <circle cx="200" cy="150" r="42" fill={B} />
        <circle cx="320" cy="150" r="30" fill={G} />
      </g>
    )
  }
  {
    name === 'the-rack' && (
      <g>
        {[0, 1, 2, 3].map((i) => (
          <g>
            <rect x="100" y={60 + i * 48} width="200" height="34" fill={B} opacity={0.55 + i * 0.15} />
            <circle cx="276" cy={77 + i * 48} r="6" fill={i === 3 ? G : W} />
          </g>
        ))}
      </g>
    )
  }
  {
    name === 'Cycling' && (
      <g fill="none" stroke-width="14">
        <circle cx="120" cy="180" r="64" stroke={B} />
        <circle cx="280" cy="180" r="64" stroke={B} />
        <path d="M120 180 L190 180 L250 110 L160 110 Z M250 110 L280 180" stroke={G} stroke-width="10" stroke-linejoin="round" />
      </g>
    )
  }
  {
    name === 'Kickboxing' && (
      <g>
        <circle cx="200" cy="150" r="96" fill={B} />
        <circle cx="236" cy="128" r="40" fill={G} />
      </g>
    )
  }
  {
    name === 'Lego' && (
      <g>
        <rect x="90" y="140" width="220" height="100" fill={B} />
        {[0, 1, 2, 3].map((i) => (
          <rect x={106 + i * 52} y="112" width="32" height="28" fill={i === 1 ? G : B} />
        ))}
      </g>
    )
  }
  {
    name === 'Games' && (
      <g>
        <rect x="90" y="130" width="72" height="24" fill={B} />
        <rect x="114" y="106" width="24" height="72" fill={B} />
        <circle cx="262" cy="118" r="16" fill={G} />
        <circle cx="296" cy="150" r="16" fill={B} />
        <circle cx="228" cy="150" r="16" fill={B} />
        <circle cx="262" cy="182" r="16" fill={B} />
      </g>
    )
  }
</svg>

<style>
  .motif {
    display: block;
    width: 100%;
    height: 100%;
  }
  .motif.deep {
    --blue: #ffffff;
    --green: #8fe0b6;
  }
</style>

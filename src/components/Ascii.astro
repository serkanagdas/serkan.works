---
// A canvas that plays one of the ASCII scenes in src/lib/scenes.
interface Props {
  scene: string;
  tone?: 'light' | 'deep' | 'deep-green';
  cell?: number | 'auto';
  class?: string;
}
const { scene, tone = 'light', cell = 5, class: cls } = Astro.props;
---

<canvas class:list={['ascii', cls]} data-scene={scene} data-tone={tone} data-cell={cell} aria-hidden="true"></canvas>

<style>
  .ascii {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import { mountAll } from '../lib/ascii';
  mountAll();
</script>

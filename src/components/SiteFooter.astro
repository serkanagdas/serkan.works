---
interface Props {
  slim?: boolean;
}
const { slim = false } = Astro.props;
---

{
  slim ? (
    <footer class="footer-slim">
      <div class="wrap">
        <span>© 2026 Serkan Ağdaş — serkan.works</span>
        <span>
          <a href="https://github.com/serkanagdas" rel="noopener">GitHub ↗</a>
          {' · '}
          <a href="mailto:merhaba@serkan.works">merhaba@serkan.works</a>
        </span>
      </div>
    </footer>
  ) : (
    <footer id="iletisim" class="footer" aria-labelledby="iletisim-title">
      <div class="wrap">
        <h2 id="iletisim-title">Bir sistem kuralım.</h2>
        <p>Yeni projelere, danışmanlığa ve iyi bir sohbete açığım — en hızlı yol e-posta ya da GitHub.</p>
        <div class="footer-ctas">
          <a class="btn btn-primary" href="mailto:merhaba@serkan.works">merhaba@serkan.works</a>
          <a class="btn btn-ghost" href="https://github.com/serkanagdas" rel="noopener">GitHub ↗</a>
        </div>
        <div class="footer-meta">
          <span>© 2026 Serkan Ağdaş — serkan.works</span>
          <span>
            Türkiye · <span class="clock" id="clock">--:--</span> (TSİ)
          </span>
        </div>
      </div>
    </footer>
  )
}

{
  !slim && (
    <script>
      // İstanbul saati
      const clockEl = document.getElementById('clock');
      if (clockEl) {
        const tick = () => {
          clockEl.textContent = new Intl.DateTimeFormat('tr-TR', {
            hour: '2-digit',
            minute: '2-digit',
            timeZone: 'Europe/Istanbul',
          }).format(new Date());
        };
        tick();
        setInterval(tick, 30000);
      }
    </script>
  )
}

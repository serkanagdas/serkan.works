---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { posts, day } from '../../lib/blog';

export async function getStaticPaths() {
  const all = await posts();
  return all.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title="Blog" description={post.data.description} doc={post.data.title}>
  <section class="page">
    <hr class="top" />
    <h2 class="title">{post.data.title}</h2>
    <p class="desc">{post.data.description}</p>
    <div class="meta">
      <span>{day(post.data.date)}</span>
      <a href={`/blog/tag/${post.data.tag}`}>{post.data.tag}</a>
    </div>
    <hr class="bottom" />
    <div class="prose">
      <Content />
    </div>
  </section>
</Base>

<style>
  .page {
    padding: 3rem 0;
  }
  .top {
    margin-bottom: 1.25rem;
  }
  .title {
    font-size: 1.5rem;
    line-height: 2rem;
    color: var(--black);
  }
  .desc {
    margin: 0.25rem 0;
    font-size: 1.125rem;
    line-height: 1.375;
    font-weight: 300;
    color: var(--black);
  }
  .meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.875rem;
    color: var(--faint);
  }
  .meta a:hover {
    color: var(--black);
  }
  .bottom {
    margin: 1.25rem 0 1.5rem;
  }
</style>

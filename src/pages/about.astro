---
import Base from '../layouts/Base.astro';
import { about, links } from '../data/site';
---

<Base title="About">
  <main class="frame grid">
    <div class="head">
      <p class="kicker">About</p>
      <h1 class="display">Hello, <em>I’m Serkan.</em></h1>
    </div>
    <div class="text">
      {about.map((p, i) => <p class:list={{ first: i === 0 }} set:html={p} />)}
    </div>
    <aside class="links">
      <p class="kicker">Write to me</p>
      <ul>
        {
          links.map((l) => (
            <li>
              <span>{l.label}</span>
              <a href={l.href} rel={l.href.startsWith('http') ? 'me' : undefined}>{l.value}</a>
            </li>
          ))
        }
      </ul>
    </aside>
  </main>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 0 24px;
    padding-top: 80px;
  }
  .head {
    grid-column: 1 / -1;
    margin-bottom: 64px;
  }
  .text {
    grid-column: 1 / span 7;
    font-size: 19px;
  }
  .first {
    font-size: 24px;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }
  .text :global(a) {
    text-decoration-color: var(--green);
    text-underline-offset: 3px;
  }
  .links {
    grid-column: 9 / -1;
  }
  .links ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 0;
    border-top: 1px solid var(--rule);
    font-size: 15px;
  }
  .links span {
    color: var(--ink-faint);
  }
  .links a {
    text-decoration: none;
    font-weight: 500;
  }
  .links a:hover {
    color: var(--blue);
  }
  @media (max-width: 820px) {
    .text,
    .links {
      grid-column: 1 / -1;
    }
    .links {
      margin-top: 48px;
    }
  }
</style>

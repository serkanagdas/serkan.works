---
import Base from '../layouts/Base.astro';
import { pictures } from '../data/pictures';
---

<Base title="Pictures" description="Photos from the hobbies of Serkan Ağdaş.">
  <section class="page">
    <p class="head">With the screen off</p>
    <div class="list">
      {
        pictures.map((p) => (
          <figure>
            {p.src && <img src={p.src} alt={p.alt ?? p.caption} loading="lazy" decoding="async" />}
            <figcaption>
              <span class="title">{p.title}</span>
              <span class="caption">{p.caption}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
    <p class="note">Photos are on their way. Until then, the captions will have to do.</p>
  </section>
</Base>

<style>
  .page {
    padding: 3rem 0;
  }
  .head {
    margin-bottom: 1rem;
    font-size: 1.125rem;
  }
  .list {
    display: grid;
    gap: 0.5rem;
  }
  figure {
    margin: 0 -0.75rem;
    padding: 0.75rem;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: 0.75rem;
  }
  figcaption {
    display: grid;
    gap: 0.125rem;
  }
  .title {
    font-size: 1.125rem;
    color: var(--black);
  }
  .caption {
    color: var(--soft);
  }
  .note {
    margin-top: 2rem;
    font-size: 0.875rem;
    color: var(--faint);
  }
</style>

---
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';
import { pictures } from '../data/pictures';
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];
---

<Base title="Pictures" description="Photos from the hobbies of Serkan Ağdaş.">
  <main class="wrap">
    <header class="head">
      <p class="sc kicker">Pictures</p>
      <h1 class="page-title">With the screen off</h1>
      <p class="sub">Cycling, kickboxing, Lego and games. Some of the better photos.</p>
    </header>
    <ul class="grid">
      {
        pictures.map((p, i) => (
          <li>
            <figure>
              <div class="frame">
                {p.src ? <img src={p.src} alt={p.alt ?? p.caption} loading="lazy" decoding="async" /> : <Plate name={p.title} />}
              </div>
              <figcaption class="fig-caption">
                <b>Fig. {roman[i]}.</b> {p.title}. {p.caption}
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </main>
</Base>

<style>
  .wrap {
    width: min(960px, 100% - 48px);
    margin: 0 auto;
  }
  .head {
    margin: 80px auto 64px;
    text-align: center;
  }
  .kicker {
    color: var(--green);
    margin-bottom: 8px;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 56px 40px;
  }
  figure {
    margin: 0;
  }
  .frame {
    aspect-ratio: 4 / 3;
    border: 1px solid var(--rule);
    padding: 16px;
    background: #fff;
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  figcaption {
    margin-top: 12px;
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

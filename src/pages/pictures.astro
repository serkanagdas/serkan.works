---
import Base from '../layouts/Base.astro';
import Motif from '../components/Motif.astro';
import { pictures } from '../data/pictures';
---

<Base title="Pictures" description="Photos from the hobbies of Serkan Ağdaş.">
  <main class="frame">
    <div class="head">
      <p class="kicker">Pictures</p>
      <h1 class="display">With the <em>screen off.</em></h1>
    </div>
    <ul class="grid">
      {
        pictures.map((p, i) => (
          <li>
            <figure>
              <div class:list={['plate', i % 3 === 1 ? 'g' : 'b']}>
                {p.src ? <img src={p.src} alt={p.alt ?? p.caption} loading="lazy" decoding="async" /> : <Motif name={p.title} />}
              </div>
              <figcaption>
                <strong>{p.title}</strong>
                <span>{p.caption}</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </main>
</Base>

<style>
  .head {
    padding-top: 80px;
    margin-bottom: 64px;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 48px 32px;
  }
  figure {
    margin: 0;
  }
  .plate {
    aspect-ratio: 5 / 4;
    overflow: hidden;
  }
  .plate.b {
    background: var(--blue-tint);
  }
  .plate.g {
    background: var(--green-tint);
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 14px;
    font-size: 15px;
  }
  figcaption strong {
    font-weight: 600;
  }
  figcaption span {
    color: var(--ink-soft);
    text-align: right;
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

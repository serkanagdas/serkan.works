---
import Base from '../layouts/Base.astro';
import { pictures, placeholders } from '../data/pictures';
---

<Base title="Pictures" page="pictures" description="Photos from the hobbies of Serkan Ağdaş: cycling, kickboxing, Lego and games.">
  <header class="intro col">
    <h1>Pictures</h1>
    <p class="tagline">
      What the screen-off hours look like. Every photo arrives as text first; hover or tap to let it develop.
    </p>
  </header>

  <section class="wide">
    <ul class="grid">
      {
        pictures.map((p) => (
          <li>
            <figure class:list={['frame', { real: p.src }]} tabindex={p.src ? 0 : undefined}>
              <div class="plate glass">
                <pre class="ascii" aria-hidden="true">{p.src ? '' : placeholders[p.tag]}</pre>
                {p.src && <img src={p.src} alt={p.alt ?? p.caption} loading="lazy" decoding="async" />}
              </div>
              <figcaption>
                <span class="tag mono">{p.tag}</span>
                {p.caption}
                {!p.src && <span class="soon mono">photo on its way</span>}
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .intro {
    margin-top: 72px;
  }

  h1 {
    margin: 0;
    font: 600 clamp(30px, 5vw, 40px)/1.1 var(--sans);
    letter-spacing: -0.03em;
  }

  .tagline {
    margin: 14px 0 0;
    max-width: 32em;
    font-size: 18px;
    color: var(--ink-2);
  }

  section {
    margin-top: 48px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 28px 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  figure {
    margin: 0;
  }

  .plate {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 22px;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: var(--glass-fill);
  }

  .ascii {
    margin: 0;
    font-family: ui-monospace, Menlo, Consolas, 'DejaVu Sans Mono', 'Liberation Mono', monospace;
    font-size: 15px;
    line-height: 1.15;
    color: var(--ascii-strong);
    user-select: none;
  }

  .real .ascii {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 6px;
    line-height: 6px;
    letter-spacing: 0;
    color: var(--ascii-strong);
  }

  img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.9s cubic-bezier(0.7, 0, 0.2, 1);
  }

  .real {
    cursor: pointer;
  }

  .real:hover img,
  .real:focus-visible img,
  .real.developed img {
    clip-path: inset(0 0 0 0);
  }

  figcaption {
    margin-top: 12px;
    font-size: 14.5px;
    color: var(--ink-2);
  }

  .tag {
    display: block;
    font-size: 11.5px;
    color: var(--blue);
    margin-bottom: 2px;
  }

  .soon {
    display: block;
    margin-top: 4px;
    font-size: 11.5px;
    color: var(--ink-3);
  }
</style>

<script>
  // Turn each photo into text: sample brightness on a small canvas, map to a character ramp.
  const RAMP = ' .:-=+*#%@';
  const dark = matchMedia('(prefers-color-scheme: dark)');

  function asciify(fig: HTMLElement) {
    const img = fig.querySelector('img');
    const pre = fig.querySelector<HTMLPreElement>('.ascii');
    if (!img || !pre) return;
    const run = () => {
      const plate = pre.parentElement!;
      const charW = 6 * 0.6;
      const cols = Math.floor(plate.clientWidth / charW);
      const rows = Math.floor(plate.clientHeight / 6);
      const c = document.createElement('canvas');
      c.width = cols;
      c.height = rows;
      const g = c.getContext('2d', { willReadFrequently: true })!;
      // work in plate pixels, then squash each char cell into one canvas pixel
      const W = plate.clientWidth;
      const H = plate.clientHeight;
      g.scale(cols / W, rows / H);
      const s = Math.max(W / img.naturalWidth, H / img.naturalHeight); // same crop as object-fit: cover
      const iw = img.naturalWidth * s;
      const ih = img.naturalHeight * s;
      g.drawImage(img, (W - iw) / 2, (H - ih) / 2, iw, ih);
      const d = g.getImageData(0, 0, cols, rows).data;
      let out = '';
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          const i = (y * cols + x) * 4;
          let l = (0.2126 * d[i] + 0.7152 * d[i + 1] + 0.0722 * d[i + 2]) / 255;
          if (!dark.matches) l = 1 - l; // ink on paper: dark pixels get dense glyphs
          out += RAMP[Math.min(RAMP.length - 1, Math.floor(l * RAMP.length))];
        }
        out += '\n';
      }
      pre.textContent = out;
    };
    if (img.complete && img.naturalWidth) run();
    else img.addEventListener('load', run, { once: true });
  }

  document.querySelectorAll<HTMLElement>('figure.real').forEach((fig) => {
    asciify(fig);
    fig.addEventListener('click', () => fig.classList.toggle('developed'));
  });
  dark.addEventListener('change', () => document.querySelectorAll<HTMLElement>('figure.real').forEach(asciify));
</script>

---
import Base from '../layouts/Base.astro';
import { pictures } from '../data/pictures';
const washes = [
  ['#d6e6f5', '#a9cbe6'],
  ['#d9ece0', '#9fcbb0'],
  ['#e4eff3', '#b8d6d9'],
  ['#dceaf2', '#a7c9c0'],
];
---

<Base title="Pictures" description="Photos from the hobbies of Serkan Ağdaş.">
  <main class="wide">
    <div class="col">
      <p class="eyebrow">Pictures</p>
      <h1 class="title">With the screen off.</h1>
      <p class="lede">Cycling, kickboxing, Lego and games. A few of the better photos.</p>
    </div>
    <ul class="gallery">
      {
        pictures.map((p, i) => (
          <li>
            <figure>
              <div class="mat">
                {p.src ? (
                  <img src={p.src} alt={p.alt ?? p.caption} loading="lazy" decoding="async" />
                ) : (
                  <div class="wash" style={`--a:${washes[i % 4][0]};--b:${washes[i % 4][1]}`} />
                )}
              </div>
              <figcaption>
                <strong>{p.title}.</strong> {p.caption}
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </main>
</Base>

<style>
  .wide {
    width: min(880px, 100% - 48px);
    margin-inline: auto;
  }
  .wide .col {
    width: auto;
    max-width: var(--col);
    margin: 0 auto;
  }
  .gallery {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 56px 48px;
  }
  .gallery li:nth-child(even) {
    margin-top: 80px;
  }
  figure {
    margin: 0;
  }
  .mat {
    background: #fff;
    padding: 18px;
    box-shadow: 0 1px 2px rgba(28, 43, 51, 0.06), 0 18px 40px -24px rgba(28, 43, 51, 0.25);
  }
  .mat img,
  .wash {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .wash {
    background:
      radial-gradient(120% 70% at 30% 20%, var(--a), transparent 70%),
      radial-gradient(90% 80% at 80% 90%, var(--b), transparent 70%),
      #f3f6f4;
    filter: saturate(0.9);
  }
  figcaption {
    margin-top: 14px;
    font-size: 17px;
    font-style: italic;
    color: var(--ink-soft);
  }
  figcaption strong {
    font-style: normal;
    font-weight: 500;
    color: var(--ink);
  }
  @media (max-width: 640px) {
    .gallery {
      grid-template-columns: 1fr;
    }
    .gallery li:nth-child(even) {
      margin-top: 0;
    }
  }
</style>

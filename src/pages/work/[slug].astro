---
import Base from '../../layouts/Base.astro';
import { work } from '../../data/site';

export function getStaticPaths() {
  return work.map((w, i) => ({ params: { slug: w.slug }, props: { i } }));
}

const { i } = Astro.props;
const w = work[i];
const next = work[(i + 1) % work.length];
---

<Base title={w.title} description={`${w.title}: ${w.line}`}>
  <section class="page">
    <hr class="top" />
    <h2 class="title">{w.title}</h2>
    <p class="line">{w.line}</p>
    <div class="meta">
      <span>{w.context}</span>
      <span>{w.year}</span>
    </div>
    <hr class="bottom" />
    <div class="prose">
      {w.body.map((p) => <p>{p}</p>)}
      <ul>
        {w.notes.map((n) => <li>{n}</li>)}
      </ul>
      <p class="stack">Made with {w.stack.join(', ')}.</p>
    </div>
    <p class="next">
      <span class="g">next</span> <a class="link" href={`/work/${next.slug}`}>{next.title}</a>
    </p>
  </section>
</Base>

<style>
  .page {
    padding: 3rem 0;
  }
  .top {
    margin-bottom: 1.25rem;
  }
  .title {
    font-size: 1.5rem;
    line-height: 2rem;
    color: var(--black);
  }
  .line {
    margin: 0.25rem 0;
    font-size: 1.125rem;
    line-height: 1.375;
    font-weight: 300;
    color: var(--black);
  }
  .meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.875rem;
    color: var(--faint);
  }
  .bottom {
    margin: 1.25rem 0 1.5rem;
  }
  .stack {
    color: var(--soft);
  }
  .next {
    margin-top: 3rem;
    font-size: 1.125rem;
  }
</style>

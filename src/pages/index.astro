---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Rider from '../components/Rider.astro';
import { about, work } from '../data/site';
---

<Base>
  <p class="is"><span class="g">likes</span> hardware <span class="g">&amp;</span> software</p>
  <div class="text">
    <div class="about">
      {about.map((p) => <p set:html={p.replaceAll('<a ', '<a class="link" ')} />)}
    </div>

    <div class="made">
      <p>Some things I’ve made include:</p>
      {
        work.map((w) => (
          <a class="pair" href={`/work/${w.slug}`}>
            <div class="name">
              {w.title} <Arrow />
            </div>
            <div>
              <p>{w.line}</p>
              <aside>
                {w.context}, {w.year}
              </aside>
            </div>
          </a>
        ))
      }
    </div>

    <p>I write about the things I build, break and fix on <a href="/blog" class="link">my blog</a>.</p>
    <Rider />
  </div>
</Base>

<style>
  .is {
    margin-bottom: 2rem;
    font-size: 1.25rem;
    line-height: 1.75rem;
    font-weight: 300;
    color: var(--black);
  }
  .text {
    display: grid;
    gap: 2rem;
    font-size: 1.125rem;
    line-height: 1.75rem;
  }
  .about {
    display: grid;
    gap: 1rem;
  }
  .made {
    display: grid;
    gap: 1rem;
    line-height: 1.375;
  }
  .pair {
    display: grid;
    gap: 0.25rem;
    margin: 0 -0.75rem;
    padding: 0.5rem 0.75rem;
    transition: background-color 0.15s;
  }
  .pair:hover {
    background: var(--hover);
  }
  .name {
    font-weight: 500;
    color: var(--black);
  }
  aside {
    margin-top: 0.125rem;
    font-size: 1rem;
    line-height: 1.5rem;
    color: var(--soft);
  }
  @media (min-width: 640px) {
    .pair {
      grid-template-columns: 1fr 2fr;
    }
  }
  @media (max-width: 420px) {
    .is {
      margin-top: -2.5rem;
    }
  }
</style>

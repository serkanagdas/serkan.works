---
import Base from '../layouts/Base.astro';
import Landscape from '../components/Landscape.astro';
import { site } from '../data/site';
---

<Base home>
  <main class="stage">
    <Landscape />
    <div class="sky">
      <h1>{site.name}</h1>
      <p class="who">Software engineer, {site.location}.</p>
      <p class="line">I tend to think most problems are unfinished projects.</p>
      <nav aria-label="Primary">
        <a href="/about">About</a>
        <a href="/work">Work</a>
        <a href="/pictures">Pictures</a>
        <a href="mailto:hello@serkan.works">Write to me</a>
      </nav>
    </div>
  </main>
</Base>

<style>
  :global(body.home) {
    height: 100svh;
    overflow: hidden;
  }

  .stage {
    position: relative;
    height: 100svh;
    overflow: hidden;
  }

  .sky {
    position: relative;
    padding: clamp(40px, 11vh, 120px) clamp(24px, 8vw, 128px) 0;
    max-width: 900px;
  }

  h1 {
    margin: 0;
    font-weight: 300;
    font-size: clamp(52px, 9vw, 128px);
    line-height: 0.95;
    letter-spacing: -0.035em;
    animation: rise 1.6s cubic-bezier(0.2, 0.7, 0.1, 1) both;
  }

  .who {
    margin: 22px 0 0;
    font-size: clamp(20px, 2.2vw, 26px);
    font-style: italic;
    color: var(--blue);
    animation: rise 1.6s 0.15s cubic-bezier(0.2, 0.7, 0.1, 1) both;
  }

  .line {
    margin: 4px 0 0;
    font-size: clamp(18px, 1.9vw, 22px);
    color: var(--ink-soft);
    animation: rise 1.6s 0.3s cubic-bezier(0.2, 0.7, 0.1, 1) both;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 26px;
    margin-top: 36px;
    font-size: 18px;
    animation: rise 1.6s 0.45s cubic-bezier(0.2, 0.7, 0.1, 1) both;
  }

  nav a {
    text-decoration-color: color-mix(in srgb, var(--green) 40%, transparent);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    h1,
    .who,
    .line,
    nav {
      animation: none;
    }
  }
</style>

---
import '../styles/global.css';

const projects = [
  {
    title: 'EDOOR — Eser & Kütüphane Sistemi',
    role: 'kurumsal · analiz + full-stack',
    desc: 'Türkiye Yazma Eserler Kurumu Kitap Şifahanesi süreçlerini dijitalleştiren kurumsal sistem. Tersine mühendislik analizi, güvenlik taraması, 37 tablolu veri modeli çözümlemesi ve aktif geliştirme.',
    stack: ['PHP 8.2', 'PostgreSQL', 'Tailwind', 'jQuery'],
  },
  {
    title: 'Eser Tarama',
    role: 'Full-stack · mimari + geliştirme',
    desc: 'Nadir eser dijitalleştirme "fabrika hattı". Çok lokasyonda taranan eserler tek havuzda toplanır, sayfa seviyesinde kabul/red, kanıtlı log, maaş ve cihaz raporları.',
    stack: ['Laravel 13', 'PostgreSQL', 'Tailwind 4', 'Queue/Job'],
  },
  {
    title: 'PDKS Analiz Platformu',
    role: 'Full-stack · analiz + pitchdeck',
    desc: 'Personel takip verisinin zamansal görselleştirmesi ve yatay raporlama ekranları. Yönetici paneli + müşteri sunum uygulaması.',
    stack: ['Next.js 15', 'React', 'Drizzle', 'PostgreSQL'],
  },
  {
    title: 'e-Door Kurumsal Site',
    role: 'Frontend',
    desc: 'Şirket vitrini — statik, hızlı, temiz. Build-time render, sade içerik yönetimi, performans öncelikli.',
    stack: ['Astro 5', 'Tailwind 3', 'MDX'],
  },
  {
    title: 'Hermes & Agent Orkestrasyonu',
    role: 'Kişisel proje · 7/7',
    desc: 'Kendi LLM agent ekosistemim. OpenHands işçileri 7/7 çalışıyor: Linear issue → branch → PR. Ben kokpitten izliyorum.',
    stack: ['Ollama', 'OpenHands', 'Docker', 'Linear API'],
  },
  {
    title: 'Şirket Sunucusu Mimarisi',
    role: 'Altyapı · planlama',
    desc: 'Tek fiziksel sunucu, Proxmox üzerinde 3 VM: DMZ, iç dünya (Tailscale-only) ve agent laboratuvarı. Blast-radius güvenliği.',
    stack: ['Proxmox', 'Traefik', 'Tailscale', 'Cloudflare'],
  },
  {
    title: 'Halısaha Rezervasyon',
    role: 'Side project · fikir aşamasında',
    desc: 'Saha + oyuncu eşleştirme, dinamik takım kurma, rezervasyon akışı. Hafta sonu maç derdine son.',
    stack: ['Next.js', 'TypeScript', 'Drizzle', 'Netgsm'],
    wip: true,
  },
];

const stack = [
  { group: 'Backend', items: ['PHP / Laravel', 'PostgreSQL', 'Python', 'REST & GraphQL', 'Redis / Queue'] },
  { group: 'Frontend', items: ['JavaScript / TS', 'Astro', 'Tailwind', 'React / Next.js'] },
  { group: 'Altyapı', items: ['Docker', 'Proxmox', 'Tailscale', 'Caddy / Traefik', 'umbrelOS'] },
  { group: 'Yapay Zeka', items: ['Ollama', 'OpenHands', 'Hermes Agent', 'Agentik sistemler'] },
];

const hobbies = [
  { icon: '🥊', title: 'Kickboks', when: 'Pzt / Çar' },
  { icon: '🏋️', title: 'Fitness', when: 'Her gün' },
  { icon: '⚽', title: 'Halısaha', when: 'Hafta sonu' },
  { icon: '🚴', title: 'Bisiklet', when: 'Sabah' },
  { icon: '🎾', title: 'Tenis', when: 'Serbest' },
  { icon: '🎧', title: 'Hip-hop', when: '7/24' },
  { icon: '⌚', title: 'Saatler', when: 'Koleksiyon' },
  { icon: '🖥️', title: 'Oyun sunucusu', when: 'Arkadaşlarla' },
];

const pipeline = [
  { label: 'Linear issue', sub: 'iş açılır' },
  { label: 'Hermes', sub: 'koordinasyon · vault hafıza' },
  { label: 'OpenHands işçi', sub: 'sunucuda 7/7' },
  { label: 'branch + PR', sub: 'GitHub' },
  { label: 'inceleme & merge', sub: 'insan onayı' },
];
const pipelineItems = pipeline.flatMap((p, i) => (i === 0 ? [p] : [{ arrow: true }, p]));

const agentRoles = [
  { icon: '◈', title: 'Koordinatör — Hermes', desc: 'umbrelOS üzerinde container içinde çalışır. Vault, Linear, GitHub, cron ve sunucu yönetimi ona bağlı. İşi dağıtır, durumu takip eder, raporu tutar.' },
  { icon: '▸', title: 'İşçi — OpenHands', desc: 'Sunucuda 7/7 ayakta. Linear issue gelir, branch açar, kod yazar, PR açar. Arayüz sadece izleme için.' },
  { icon: '⌘', title: 'Kokpit — OpenCode + Zed', desc: 'Kendi makinem. Gündüz feature dallarına kod pushlar, plan notlarını yazar, işçilerin çıktısını denetler.' },
];

const roles = ['Yazılım Mühendisi', 'Full-stack Geliştirici', 'Altyapı Kuran Adam', 'Agent Mühendisi'];
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Serkan Ağdaş — Yazılım Mühendisi · serkan.works</title>
    <meta name="description" content="Serkan Ağdaş — yazılım mühendisi. Full-stack ürün, altyapı ve şirket içi yapay zeka otomasyon sistemleri." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // tema: flash olmadan sistem tercihi / kalıcı seçim
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main">İçeriğe geç</a>

    <nav class="nav" aria-label="Ana menü">
      <div class="nav-inner">
        <a href="#" class="nav-logo">serkan<em>.works</em></a>
        <div class="nav-links">
          <a href="#hakkinda">hakkında</a>
          <a href="#otomasyon">otomasyon</a>
          <a href="#isler">işler</a>
          <a href="#stack">stack</a>
          <a href="#iletisim">iletişim</a>
        </div>
        <button class="theme-toggle" id="theme-toggle" aria-label="Temayı değiştir" title="Tema">☀︎</button>
      </div>
    </nav>

    <main id="main">
      <!-- HERO -->
      <header class="hero wrap">
        <div class="eyebrow"><span class="dot" aria-hidden="true"></span> müsait — yeni projelere açığım</div>
        <h1>Serkan <em>Ağdaş</em></h1>
        <div class="hero-roles" aria-live="polite"><span id="typed">Yazılım Mühendisi</span><span class="cursor" aria-hidden="true"></span></div>
        <p class="hero-sub">
          <b>Yazılım mühendisiyim.</b> Full-stack ürün çıkarır, altyapı kurarım — ve şirkette
          <b>yapay zeka otomasyon sistemi</b> ile 7/7 çalışan bir agent ekosistemi işletiyorum.
        </p>
        <div class="hero-ctas">
          <a href="#otomasyon" class="btn btn-primary">Otomasyonu gör <span aria-hidden="true">→</span></a>
          <a href="#isler" class="btn btn-ghost">İşleri gez</a>
        </div>
      </header>

      <!-- HAKKINDA -->
      <section id="hakkinda" class="wrap reveal">
        <div class="kicker">hakkında</div>
        <h2 class="section-title">Sade, hızlı, çalışan sistemler.</h2>
        <div class="about-grid">
          <aside class="card" aria-label="Profil kartı">
            <div class="profile-head">
              <div class="avatar" aria-hidden="true">SA</div>
              <div>
                <h3>Serkan Ağdaş</h3>
                <div class="sub">yazılım mühendisi · 2002 · remote / hibrit</div>
              </div>
            </div>
            <div class="fact-rows">
              <div class="row"><span class="k">odak</span><span class="v">Full-stack + Altyapı</span></div>
              <div class="row"><span class="k">habitat</span><span class="v">PHP · JS · PostgreSQL · Docker</span></div>
              <div class="row"><span class="k">inanç</span><span class="v">self-host · yerel LLM</span></div>
              <div class="row"><span class="k">durum</span><span class="v"><b>müsait ✓</b></span></div>
            </div>
          </aside>
          <div class="about-text">
            <p>
              2002 doğumlu, yazılım mühendisliğinden yeni mezun bir mühendisim. Günlük işim
              <b>PHP, PostgreSQL ve JavaScript</b> ile ürün çıkarmak; arka planda
              <b>Docker, Proxmox ve Tailscale</b> ile altyapı kurmak.
            </p>
            <p>
              Açık kaynak araçlar, yerel LLM'ler ve self-hosting benim için hobiden çok çalışma
              biçimi. Kodlamaya kokpitte kendi başlıyorum; tekrarlanan işleri
              <b>agent'lara devrediyorum</b> — son kararı ve kodu hep insan denetliyor.
            </p>
            <div class="about-stats">
              <div class="stat"><div class="n">7/7</div><div class="l">işçi uptime</div></div>
              <div class="stat"><div class="n">3</div><div class="l">agent rolü</div></div>
              <div class="stat"><div class="n">issue→PR</div><div class="l">tam otomatik akış</div></div>
            </div>
          </div>
        </div>
      </section>

      <!-- OTOMASYON (featured, inverted) -->
      <section class="featured reveal" id="otomasyon" aria-labelledby="oto-title">
        <div class="kicker">yapay zeka otomasyonu</div>
        <h2 class="section-title" id="oto-title">Şirkette yapay zeka otomasyon sistemi kurdum.</h2>
        <p class="section-sub">
          İş takibinden koda kadar uzanan, kendi kurdığum agent hattı. Linear'da açılan bir iş,
          koordinatör agent tarafından işçiye dağıtılır; işçi branch açar, PR gönderir; insan
          onayı olmadan hiçbir şey merge olmaz. Tüm hafıza Obsidian vault'ta kalıcı.
        </p>
        <ol class="pipeline" aria-label="İş akışı">
          {pipelineItems.map((p) => ('arrow' in p
            ? <li class="pipe-arrow" aria-hidden="true">→</li>
            : <li class="pipe-node"><span>{p.label}</span><small>{p.sub}</small></li>
          ))}
        </ol>
        <div class="agent-roles">
          {agentRoles.map((r) => (
            <div class="role-card">
              <h4><span class="icon" aria-hidden="true">{r.icon}</span>{r.title}</h4>
              <p>{r.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- İŞLER -->
      <section id="isler" class="wrap reveal">
        <div class="kicker">işler</div>
        <h2 class="section-title">Seçili projeler.</h2>
        <p class="section-sub">Kurumsal sistemlerden kişisel altyapı projelerine — her biri gerçekten çalışan, sürdürülen işler.</p>
        <div class="proj-grid">
          {projects.map((p) => (
            <article class="proj">
              <div class="proj-top">
                <div>
                  <h3>{p.title}</h3>
                  <div class="role">{p.role}</div>
                </div>
                {p.wip && <span class="wip">WIP</span>}
              </div>
              <p>{p.desc}</p>
              <div class="chips">{p.stack.map((s) => <span class="chip">{s}</span>)}</div>
            </article>
          ))}
        </div>
      </section>

      <!-- STACK -->
      <section id="stack" class="wrap reveal">
        <div class="kicker">stack</div>
        <h2 class="section-title">Ne ile çalışıyorum.</h2>
        <p class="section-sub">Geniş ama derin — her katmanda üretim tecrübesi olan bir yığın.</p>
        <div class="stack-grid">
          {stack.map((g) => (
            <div class="stack-group">
              <h3>{g.group}</h3>
              <div class="pills">{g.items.map((i) => <span class="pill">{i}</span>)}</div>
            </div>
          ))}
        </div>
      </section>

      <!-- HOBİLER -->
      <section id="ekran-kapaliyken" class="wrap reveal">
        <div class="kicker">ekran kapalıyken</div>
        <h2 class="section-title">Müdahaleye açık alanlar.</h2>
        <p class="section-sub">Kod dışında hayatın devam ettiği yerler — bu düzen ne kadar disiplinliysem kod da o kadar düzenli.</p>
        <div class="hobby-grid">
          {hobbies.map((h) => (
            <div class="hobby">
              <span class="icon" aria-hidden="true">{h.icon}</span>
              <div>
                <div class="t">{h.title}</div>
                <div class="w">{h.when}</div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- İLETİŞİM -->
      <footer class="footer wrap" id="iletisim">
        <h2>Bir sistem kuram mı gerekiyor?</h2>
        <p>Yeni projelere, danışmanlığa ve iyi bir sohbete açığım. En hızlı yol e-posta ya da GitHub.</p>
        <div class="footer-ctas">
          <a class="btn btn-primary" href="https://github.com/serkanagdas" rel="noopener">GitHub ↗</a>
          <a class="btn btn-ghost" href="mailto:merhaba@serkan.works">merhaba@serkan.works</a>
        </div>
        <div class="footer-meta">
          <span>© 2026 Serkan Ağdaş — serkan.works</span>
          <span>Türkiye · <span class="clock" id="clock">--:--</span> (TSİ)</span>
        </div>
      </footer>
    </main>

    <script define:vars={{ roles }}>
      // tema toggle
      var root = document.documentElement;
      var toggle = document.getElementById('theme-toggle');
      function syncIcon() {
        toggle.textContent = root.dataset.theme === 'dark' ? '☾' : '☀︎';
        toggle.title = root.dataset.theme === 'dark' ? 'Açık temaya geç' : 'Koyu temaya geç';
      }
      syncIcon();
      toggle.addEventListener('click', () => {
        var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
        syncIcon();
      });

      // yazma efekti (reduced-motion'da sabit başlık)
      var typed = document.getElementById('typed');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        typed.textContent = roles[0];
      } else {
        var ri = 0, ci = 0, deleting = false;
        (function tick() {
          var full = roles[ri];
          typed.textContent = full.slice(0, ci);
          if (!deleting) {
            if (ci < full.length) { ci++; setTimeout(tick, 90); }
            else { deleting = true; setTimeout(tick, 2200); }
          } else {
            if (ci > 0) { ci--; setTimeout(tick, 40); }
            else { deleting = false; ri = (ri + 1) % roles.length; setTimeout(tick, 400); }
          }
        })();
      }

      // İstanbul saati
      function clock() {
        var d = new Date();
        var tr = new Intl.DateTimeFormat('tr-TR', {
          hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Istanbul',
        });
        document.getElementById('clock').textContent = tr.format(d);
      }
      clock(); setInterval(clock, 30000);

      // scroll reveal
      var els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        var io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { threshold: 0.12 });
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>

---
import '../styles/global.css';

const projects = [
  {
    title: 'Eser Tarama',
    role: 'Full-stack · mimari + geliştirme',
    desc: 'Nadir eser dijitalleştirme "fabrika hattı". Çok lokasyonda taranan eserler tek havuzda toplanır, sayfa seviyesinde kabul/red, kanıtlı log, maaş ve cihaz raporları.',
    stack: ['Laravel 13', 'PostgreSQL', 'Tailwind 4', 'Queue/Job'],
  },
  {
    title: 'PDKS Analiz Platformu',
    role: 'Full-stack · analiz + pitchdeck',
    desc: 'Personel takip verisinin zamansal görselleştirmesi ve yatay raporlama ekranları. Yönetici paneli + müşteri sunum uygulaması.',
    stack: ['Next.js 16', 'React 19', 'Drizzle', 'PostgreSQL'],
  },
  {
    title: 'e-Door Kurumsal Site',
    role: 'Frontend',
    desc: 'Şirket vitrini — statik, hızlı, temiz. Build-time render, sade içerik yönetimi, performans öncelikli.',
    stack: ['Astro 5', 'Tailwind 3', 'MDX'],
  },
  {
    title: 'Hermes & Agent Orkestrasyonu',
    role: 'Kişisel proje · 7/24',
    desc: 'Kendi LLM agent ekosistemim. OpenHands işçileri 7/24: Linear issue → branch → PR. Ben kokpitte izliyorum.',
    stack: ['Ollama', 'OpenHands', 'Docker', 'Linear API'],
  },
  {
    title: 'Şirket Sunucusu Mimarisi',
    role: 'Altyapı · planlama',
    desc: 'Tek fiziksel sunucu, Proxmox üzerinde 3 VM: DMZ, iç dünya (Tailscale-only) ve agent laboratuvarı. Blast-radius güvenliği.',
    stack: ['Proxmox', 'Traefik', 'Tailscale', 'Cloudflare'],
  },
  {
    title: 'Halısaha Rezervasyon',
    role: 'Side project · fikir aşaması',
    desc: 'Saha + oyuncu eşleştirme, dinamik takım kurma, rezervasyon akışı. Hafta sonu maç derdine son.',
    stack: ['PHP', 'PostgreSQL', 'Livewire'],
    wip: true,
  },
];

const stack = [
  { group: 'Backend', items: ['PHP / Laravel', 'PostgreSQL', 'Python', 'REST & GraphQL', 'Redis / Queue'] },
  { group: 'Frontend', items: ['JavaScript', 'Astro', 'Tailwind', 'React / Next.js'] },
  { group: 'Altyapı', items: ['Docker', 'Proxmox', 'Tailscale', 'Caddy / Traefik'] },
  { group: 'Yapay Zeka', items: ['Ollama', 'OpenHands', 'Agentik sistemler'] },
];

const hobbies = [
  { icon: '🥊', title: 'Kickboks', when: 'Pzt / Çar' },
  { icon: '🏋️', title: 'Fitness', when: 'Her gün' },
  { icon: '⚽', title: 'Halısaha', when: 'Hafta sonu' },
  { icon: '🚴', title: 'Bisiklet', when: 'Sabah' },
  { icon: '🎧', title: 'Hip-hop', when: '7/24' },
  { icon: '⌚', title: 'Saatler', when: 'Koleksiyon' },
];
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Serkan Ağdaş — Yazılım Mühendisi</title>
    <meta name="description" content="Serkan Ağdaş — yazılım mühendisi, self-host fanatiği, agent kuran adam." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="bg" aria-hidden="true">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
      <div class="bg-grid"></div>
      <div class="bg-noise"></div>
    </div>

    <nav class="dock">
      <a href="#" class="dock-logo">serkan<em>.works</em></a>
      <a href="#isler" class="link keep">işler</a>
      <a href="#profil" class="link keep">profil</a>
      <a href="#stack" class="link">stack</a>
      <a href="#terminal" class="link">terminal</a>
      <a href="#iletisim" class="dock-cta">yaz →</a>
    </nav>

    <main class="wrap">
      <!-- HERO -->
      <header class="hero reveal in">
        <div class="eyebrow"><span class="dot"></span> müsait — yeni projelere açığım</div>
        <h1>Serkan <span class="grad">Ağdaş</span></h1>
        <div class="hero-roles"><span id="typed">Yazılım Mühendisi</span><span class="cursor"></span></div>
        <p class="hero-sub">
          <b>Full-stack yazılım mühendisi.</b> PHP, PostgreSQL ve JavaScript ile ürün;
          Docker, Proxmox ve agent'larla altyapı kurarım.
        </p>
        <div class="hero-ctas">
          <a href="#isler" class="btn btn-white">İşleri gör <span>→</span></a>
          <a href="#terminal" class="btn btn-glass">$ terminal'i aç</a>
        </div>
      </header>

      <!-- BENTO -->
      <section class="bento">

        <!-- PROJELER: carousel, scroll yok -->
        <article class="glass span-7 reveal" id="isler">
          <div class="card-top">
            <div class="card-kicker"><i></i>Seçili işler</div>
            <div class="proj-count"><span id="proj-index">01</span> / 06</div>
          </div>
          <div class="proj-stage" id="proj-stage">
            {projects.map((p, i) => (
              <div class:list={['proj', { active: i === 0 }]} data-proj={i}>
                <h3>{p.title}{p.wip && <span class="wip-pill">WIP</span>}</h3>
                <div class="role">{p.role}</div>
                <p>{p.desc}</p>
                <div class="chips">{p.stack.map((s) => <span class="chip">{s}</span>)}</div>
              </div>
            ))}
          </div>
          <div class="proj-nav">
            <div class="dots" id="proj-dots">
              {projects.map((_, i) => (
                <button class:list={['dot-btn', { on: i === 0 }]} data-dot={i} aria-label={'Proje ' + (i + 1)}></button>
              ))}
            </div>
            <div class="arrows">
              <button class="arrow-btn" id="proj-prev" aria-label="Önceki">←</button>
              <button class="arrow-btn" id="proj-next" aria-label="Sonraki">→</button>
            </div>
          </div>
        </article>

        <!-- PROFİL -->
        <aside class="glass span-5 reveal" id="profil">
          <div class="card-top">
            <div class="card-kicker"><i></i>profil</div>
            <div class="proj-count">TR · <b id="clock" style="color:var(--accent)">--:--</b></div>
          </div>
          <div class="profile-head">
            <div class="avatar">SA</div>
            <div>
              <h3>Serkan Ağdaş</h3>
              <div class="sub">yazılım mühendisi · 2002 · remote/hibrit</div>
            </div>
          </div>
          <div class="fact-rows">
            <div class="row"><span class="k">odak</span><span class="v">Full-stack + Altyapı</span></div>
            <div class="row"><span class="k">habitat</span><span class="v">PHP · JS · PG · Docker</span></div>
            <div class="row"><span class="k">inanç</span><span class="v">self-host · yerel LLM</span></div>
            <div class="row"><span class="k">durum</span><span class="v"><b>müsait ✓</b></span></div>
          </div>
          <div class="sysbar">
            <span><i class="ok"></i>agents: 3 online</span>
            <span>proxmox: idle 12%</span>
            <span>☕ 2. fincan</span>
          </div>
        </aside>

        <!-- STACK -->
        <article class="glass span-4 reveal" id="stack">
          <div class="card-top"><div class="card-kicker"><i></i>stack</div></div>
          {stack.map((g) => (
            <div class="stack-group">
              <h5>{g.group}</h5>
              <div class="pills">{g.items.map((i) => <span class="pill">{i}</span>)}</div>
            </div>
          ))}
        </article>

        <!-- TERMİNAL -->
        <article class="glass span-4 reveal" id="terminal">
          <div class="card-top">
            <div class="card-kicker"><i></i>oyun alanı</div>
            <div class="proj-count">zsh</div>
          </div>
          <div class="term-window">
            <div class="term-bar">
              <div class="lights"><i></i><i></i><i></i></div>
              <span class="title">serkan@umbrel: ~</span>
            </div>
            <div class="term-body" id="term-body">
              <div class="out">Serkan Ağdaş — mühendis, self-host fanatiği, kickboksçu.</div>
              <div class="out"><span class="warn">help</span> yaz, gerisi sende.</div>
              <div class="term-input-line">
                <span class="p">$</span>
                <input id="term-input" type="text" autocomplete="off" spellcheck="false" placeholder="help" />
              </div>
            </div>
          </div>
        </article>

        <!-- HOBİLER -->
        <article class="glass span-4 reveal">
          <div class="card-top"><div class="card-kicker"><i></i>ekran kapalıyken</div></div>
          <div class="hobby-list">
            {hobbies.map((h) => (
              <div class="hobby">
                <div class="ic">{h.icon}</div>
                <h4>{h.title}</h4>
                <span>▸ {h.when}</span>
              </div>
            ))}
          </div>
        </article>

        <!-- ALTYAPI -->
        <article class="glass span-7 reveal">
          <div class="card-top">
            <div class="card-kicker"><i></i>ev sunucusu — blast radius haritası</div>
          </div>
          <div class="infra-map">
            <div class="vm dmz">
              <span class="tag">DMZ · public</span>
              <h4>bulut kapısı</h4>
              <p>Traefik · Cloudflare<br />demo apps</p>
            </div>
            <div class="vm inner">
              <span class="tag">iç dünya · private</span>
              <h4>kale</h4>
              <p>Tailscale-only<br />Plane · GitLab · PG</p>
            </div>
            <div class="vm lab">
              <span class="tag">isyan-hane · agents</span>
              <h4>laboratuvar</h4>
              <p>OpenHands · Ollama<br />7/24 işçiler</p>
            </div>
          </div>
          <div class="flow"><span class="sig">●</span> issue → branch → PR → izle <span class="sig">●</span></div>
          <div class="infra-note">tek makine · proxmox · 3 VM · AdGuard önde</div>
        </article>

        <!-- İLETİŞİM -->
        <article class="glass span-5 reveal" id="iletisim">
          <div class="card-top"><div class="card-kicker"><i></i>iletişim</div></div>
          <div class="contact-big">Bir fikrin mi var?<br /><span class="grad">Yaz, konuşalım.</span></div>
          <p class="contact-sub">Proje, iş birliği ya da sadece merhaba — kutu hep açık.</p>
          <div class="contact-btns">
            <a class="cbtn" href="mailto:hello@serkan.works"><span>✉ hello@serkan.works</span><span class="arrow">→</span></a>
            <a class="cbtn" href="https://github.com/serkanagdas" target="_blank" rel="noopener"><span>⌥ github/serkanagdas</span><span class="arrow">→</span></a>
            <a class="cbtn" href="https://linkedin.com/in/serkanagdas" target="_blank" rel="noopener"><span>in linkedin/serkanagdas</span><span class="arrow">→</span></a>
          </div>
        </article>

      </section>

      <footer>
        <div class="foot reveal">
          <span>© 2026 Serkan Ağdaş — Astro ile ⚡</span>
          <span>liquid glass · bento · <b>scroll yok, keyif var</b></span>
        </div>
      </footer>
    </main>

    <script>
      // ---- Typed ----
      const roles = ['Yazılım Mühendisi', 'Self-host fanatiği', 'Kickboksçu', 'Agent kuran adam', 'PostgreSQL tiryakisi'];
      const typed = document.getElementById('typed');
      let ri = 0, ci = 0, del = false;
      function tick() {
        const w = roles[ri];
        if (!del) {
          ci++;
          typed.textContent = w.slice(0, ci);
          if (ci === w.length) { del = true; setTimeout(tick, 1800); return; }
        } else {
          ci--;
          typed.textContent = w.slice(0, ci);
          if (ci === 0) { del = false; ri = (ri + 1) % roles.length; }
        }
        setTimeout(tick, del ? 38 : 80);
      }
      setTimeout(tick, 500);

      // ---- Reveal ----
      const revealEls = [...document.querySelectorAll('.reveal:not(.in)')];
      const io = new IntersectionObserver((es) => {
        es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: 0.05, rootMargin: '80px 0px 80px 0px' });
      revealEls.forEach((el) => io.observe(el));
      // Fallback: hiçbir kart gizli kalmasın (IO kaçırırsa)
      setTimeout(() => revealEls.forEach((el) => el.classList.add('in')), 2500);

      // ---- Spotlight ----
      document.querySelectorAll('.glass').forEach((card) => {
        card.addEventListener('pointermove', (e) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', (e.clientX - r.left) + 'px');
          card.style.setProperty('--my', (e.clientY - r.top) + 'px');
        });
      });

      // ---- Clock ----
      const clock = document.getElementById('clock');
      function updateClock() {
        clock.textContent = new Date().toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Istanbul' });
      }
      updateClock(); setInterval(updateClock, 15000);

      // ---- Projects carousel ----
      const slides = [...document.querySelectorAll('[data-proj]')];
      const dots = [...document.querySelectorAll('[data-dot]')];
      const idx = document.getElementById('proj-index');
      let cur = 0, timer;
      function go(n) {
        cur = (n + slides.length) % slides.length;
        slides.forEach((s, i) => s.classList.toggle('active', i === cur));
        dots.forEach((d, i) => d.classList.toggle('on', i === cur));
        idx.textContent = String(cur + 1).padStart(2, '0');
        restart();
      }
      function restart() { clearInterval(timer); timer = setInterval(() => go(cur + 1), 7000); }
      document.getElementById('proj-next').addEventListener('click', () => go(cur + 1));
      document.getElementById('proj-prev').addEventListener('click', () => go(cur - 1));
      dots.forEach((d) => d.addEventListener('click', () => go(Number(d.dataset.dot))));
      restart();

      // ---- Terminal ----
      const body = document.getElementById('term-body');
      const input = document.getElementById('term-input');
      const responses = {
        help: 'hakkinda · projeler · stack · hobiler · iletisim · sudo · ls · clear',
        hakkinda: '2002 · full-stack · PHP+PG+JS · gündüz feature, gece agent orkestrasyonu.',
        projeler: '01 Eser Tarama · 02 PDKS · 03 e-Door · 04 Hermes Agents · 05 Sunucu Mimarisi · 06 Halısaha (WIP)',
        stack: 'BE: Laravel/PG/Python · FE: Astro/Tailwind/Next · Infra: Docker/Proxmox/Tailscale · AI: Ollama/OpenHands',
        hobiler: 'kickboks · fitness · halısaha · bisiklet · hip-hop · mekanik saatler',
        iletisim: 'hello@serkan.works · github/serkanagdas',
        sudo: 'root yok — sadece kahve. ☕',
        ls: 'projeler/ stack/ hobiler/ sunucular/ saatler/',
        whoami: 'misafir — hoş geldin.',
      };
      function print(html) {
        const div = document.createElement('div');
        div.className = 'out'; div.textContent = html;
        body.insertBefore(div, input.parentElement);
      }
      input.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter') return;
        const raw = input.value.trim();
        if (!raw) return;
        print('$ ' + raw);
        input.value = '';
        const cmd = raw.toLowerCase();
        if (cmd === 'clear') { body.querySelectorAll('.out').forEach((el) => el.remove()); return; }
        print(responses[cmd] || ('command not found: ' + raw + ' — help dene.'));
        body.scrollTop = body.scrollHeight;
      });
      body.addEventListener('click', () => input.focus());
    </script>
  </body>
</html>

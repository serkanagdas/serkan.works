---
import Base from '../layouts/Base.astro';
import Ascii from '../components/Ascii.astro';
import { site } from '../data/site';
---

<Base home>
  <main class="poster">
    <div class="scene"><Ascii scene="poster" cell="auto" /></div>
    <div class="field">
      <nav aria-label="Primary">
        <a href="/about">About</a>
        <a href="/work">Work</a>
        <a href="/pictures">Pictures</a>
        <a href="/blog">Blog</a>
      </nav>
      <a class="mail" href="mailto:hello@serkan.works">hello@serkan.works</a>
    </div>

    <h1 class="name">Serkan<br />Ağdaş</h1>
    <div class="side">
      <p class="role">Software engineer<br />{site.location}</p>
      <p class="motto"><em>Things usually work out.</em><br />I like to make sure.</p>
    </div>
  </main>
</Base>

<style>
  :global(body.home) {
    height: 100svh;
    overflow: hidden;
  }

  .poster {
    --h: 30%; /* height of the field below the horizon */
    --s: min(64vh, 46vw); /* sun */
    position: relative;
    height: 100svh;
    overflow: hidden;
  }

  .scene {
    position: absolute;
    inset: 0;
  }

  .field {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--h);
    color: #fff;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    padding: 0 var(--pad) clamp(24px, 5vh, 48px);
  }

  .field nav {
    display: flex;
    gap: clamp(20px, 3vw, 40px);
    font-size: clamp(18px, 1.8vw, 24px);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .field a {
    text-decoration: none;
    border-bottom: 2px solid rgba(255, 255, 255, 0.35);
    transition: border-color 0.2s;
  }

  .field a:hover {
    border-color: #fff;
  }

  .mail {
    font-size: 15px;
    opacity: 0.9;
  }

  .name {
    position: absolute;
    left: var(--pad);
    top: clamp(28px, 7vh, 72px);
    margin: 0;
    font-weight: 600;
    font-size: clamp(60px, 11.5vw, 184px);
    line-height: 0.86;
    letter-spacing: -0.055em;
  }

  .side {
    position: absolute;
    right: var(--pad);
    top: clamp(34px, 8vh, 84px);
    width: 240px;
    font-size: 16px;
    line-height: 1.45;
  }

  .role {
    color: var(--ink-soft);
  }

  .motto em {
    font: italic 400 26px/1.1 var(--serif);
    color: var(--ink);
  }

  .motto {
    color: var(--ink-soft);
  }

  @media (max-width: 720px) {
    .poster {
      --h: 26%;
      --s: 78vw;
    }
    .side {
      position: absolute;
      left: var(--pad);
      right: auto;
      top: calc(clamp(28px, 7vh, 72px) + 2 * 0.86 * clamp(60px, 11.5vw, 184px) + 28px);
    }
    .mail {
      display: none;
    }
  }

</style>

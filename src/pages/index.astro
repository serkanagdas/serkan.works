---
import Base from '../layouts/Base.astro';
import Bicycle from '../components/Bicycle.astro';
import { site } from '../data/site';
---

<Base home>
  <main class="sheet-body">
    <div class="intro">
      <h1>{site.name}</h1>
      <p class="sub">Software engineer in İstanbul, and an optimist by trade.</p>
    </div>
    <figure class="fig">
      <div class="draw"><Bicycle /></div>
      <figcaption class="fig-caption"><b>Fig. 1.</b> An engineer, on the way somewhere good.</figcaption>
    </figure>
    <nav aria-label="Primary" class="sc">
      <a href="/about">About</a>
      <a href="/work">Work</a>
      <a href="/pictures">Pictures</a>
      <a href="mailto:hello@serkan.works">Write</a>
    </nav>
  </main>
</Base>

<style>
  :global(body.home) {
    height: 100svh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .sheet-body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(1100px, 100% - 48px);
    margin: 0 auto;
    padding: clamp(20px, 5vh, 56px) 0 clamp(20px, 4vh, 40px);
  }

  .intro {
    text-align: center;
  }

  h1 {
    margin: 0;
    font-weight: 400;
    font-size: clamp(44px, 6.5vw, 76px);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .sub {
    font-size: clamp(19px, 2vw, 24px);
  }

  .fig {
    flex: 1;
    min-height: 0;
    width: 100%;
    margin: clamp(12px, 3vh, 32px) 0 0;
    display: flex;
    flex-direction: column;
  }

  .draw {
    flex: 1;
    min-height: 0;
    max-width: 900px;
    width: 100%;
    margin: 0 auto;
  }

  figcaption {
    margin-top: 10px;
  }

  nav {
    display: flex;
    gap: clamp(20px, 4vw, 44px);
    margin-top: clamp(14px, 3vh, 30px);
    font-size: 20px;
  }

  nav a {
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 2px;
    transition: border-color 0.2s, color 0.2s;
  }

  nav a:hover {
    border-color: var(--blue);
  }

  @media (max-width: 560px) {
    .draw {
      margin-inline: -8px;
      width: calc(100% + 16px);
    }
    nav {
      gap: 18px;
      font-size: 18px;
    }
  }
</style>
